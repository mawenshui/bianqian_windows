# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# 旧版根目录构建产物（兼容未迁移的本地环境）
build/
dist/

# 用户运行时数据（不在版本管理中）
notes/
backups/
settings.json
window_positions.json
tags.json
templates/
logs/

# 开发模式运行数据统一目录
runtime/

# 测试相关
.benchmarks/
.pytest_cache/
.coverage
test_artifacts_ui_*/

# 本地独立便携版与发布构建（安装资产通过 GitHub Release 发布）
portable_build_*/
release_build_*/

# 统一构建、发布、归档和测试产物目录，仅保留说明文件
artifacts/*
!artifacts/README.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# PyInstaller
*.spec
